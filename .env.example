# Required. Keep the token private; never commit .env.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Local AI: no API key. Start and stop it with Fainted Panel.exe.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen3-vl:2b-instruct

# Optional alternative: Gemini has a limited free tier. Create your own key at:
# https://aistudio.google.com/apikey
# Keep the project on the Free tier. Billing-enabled projects may incur charges.
# Only your submitted description/image is sent to the selected provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional alternative, only used with AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional database location. Keep this on persistent storage.
DATABASE_PATH=./data/fainted.sqlite

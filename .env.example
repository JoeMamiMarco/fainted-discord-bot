# Keep the token private. All AI runs locally; no API key is needed.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_CLIENT_SECRET=
MEMBER_DASHBOARD_ORIGIN=http://127.0.0.1:11438
# For a reverse proxy on this computer, leave the bind address at loopback.
MEMBER_DASHBOARD_BIND=127.0.0.1
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen3-vl:4b-instruct
DATABASE_PATH=./data/seep.sqlite

# Coding AI: local by default. compatible sends submitted code to your chosen HTTPS provider.
CODE_AI_PROVIDER=local
CODE_AI_URL=
CODE_AI_MODEL=
CODE_AI_KEY=

# Optional external loopback Ollama for Linux hosts; never a public model endpoint.
OLLAMA_EXTERNAL=false
SEEP_AUTOSTART=false
MEMBER_DASHBOARD_BIND=127.0.0.1
